{
  "name": "film-fusion-frontend",
  "version": "6.0.0",
  "private": true,
  "description": "Film Fusion 前端：Emby + 网盘管理控制台",
  "scripts": {
    "biome:lint": "biome lint",
    "build": "pnpm tsc && vite build",
    "deploy": "pnpm build && pnpm gh-pages",
    "dev": "vite",
    "gh-pages": "gh-pages -d dist",
    "lint": "pnpm biome:lint && pnpm tsc",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "preview": "vite preview --port 8000",
    "shadcn": "shadcn",
    "start": "vite",
    "start:dev": "vite --mode development",
    "start:pre": "vite --mode pre",
    "start:test": "vite --mode test",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:update": "vitest run -u",
    "tsc": "tsc --noEmit"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/pro-components": "3.1.14-6",
    "@base-ui/react": "^1.6.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@uiw/react-codemirror": "^4.25.10",
    "@xyflow/react": "^12.11.2",
    "antd": "^6.6.0",
    "antd-style": "^3.7.0",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "elkjs": "^0.12.0",
    "liquid-glass-react": "^1.1.1",
    "lucide-react": "^1.27.0",
    "motion": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-intl": "^10.1.18",
    "react-router": "^8.3.0",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/lodash": "^4.17.10",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "gh-pages": "^6.1.1",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "less": "^4.8.1",
    "lint-staged": "^16.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
